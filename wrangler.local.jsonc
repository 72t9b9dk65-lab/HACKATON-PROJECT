{
  "name": "hundstallet-hackathon-local",
  "compatibility_date": "2026-09-07",
  "d1_databases": [
    {
      "binding": "CARE_DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CARE_FILES",
      "bucket_name": "site-creator-r2"
    }
  ]
}
